+/*
+ * Debug snapshot of one api head's EVO state.  See NvKmsQueryHeadHwStateReply
+ * in nvkms-api.h for what each field means and why it exists: with a
+ * dynamically-connected display the head can be active (activeDpys non-empty,
+ * compositor scanning changing frames) while its connector's output resource
+ * was never programmed -- which from the framebuffer looks exactly like an
+ * accepted modeset with a frozen encoder.
+ */
+static NvBool QueryHeadHwState(struct NvKmsPerOpen *pOpen,
+                               void *pParamsVoid)
+{
+    struct NvKmsQueryHeadHwStateParams *pParams = pParamsVoid;
+
+    struct NvKmsPerOpenDev *pOpenDev =
+        GetPerOpenDev(pOpen, pParams->request.deviceHandle);
+    if (pOpenDev == NULL) {
+        return FALSE;
+    }
+
+    NVDispEvoPtr pDispEvo = pOpenDev->pDevEvo->pDispEvo[0];
+
+    if (!nvKmsOpenDevHasSubOwnerPermissionOrBetter(pOpenDev)) {
+        return FALSE;
+    }
+
+    const NvU32 apiHead = pParams->request.head;
+    if (apiHead >= ARRAY_LEN(pDispEvo->apiHeadState)) {
+        return FALSE;
+    }
+
+    nvkms_memset(&(pParams->reply), 0, sizeof(pParams->reply));
+
+    const NVDpyIdList activeDpys =
+        pDispEvo->apiHeadState[apiHead].activeDpys;
+
+    pParams->reply.headActive = !nvDpyIdListIsEmpty(activeDpys);
+    pParams->reply.activeDpysMask = nvDpyIdListToNvU32(activeDpys);
+    pParams->reply.hwHeadsMask =
+        pDispEvo->apiHeadState[apiHead].hwHeadsMask;
+
+    const NVConnectorEvoPtr pConnectorEvo =
+        pDispEvo->headState[apiHead].pConnectorEvo;
+
+    pParams->reply.connectorDriven = (pConnectorEvo != NULL);
+
+    if (pConnectorEvo != NULL) {
+        pParams->reply.orType = (NvU8)pConnectorEvo->or.type;
+        pParams->reply.orProtocol = (NvU8)pConnectorEvo->or.protocol;
+        pParams->reply.orMask = nvConnectorGetORMaskEvo(pConnectorEvo);
+        pParams->reply.connectorActive = nvIsConnectorActiveEvo(pConnectorEvo);
+        if ((pConnectorEvo->or.primary != NV_INVALID_OR) &&
+            (pConnectorEvo->or.primary < 32)) {
+            pParams->reply.orOwnerHeadMask =
+                pConnectorEvo->or.ownerHeadMask[pConnectorEvo->or.primary];
         }
     }
 
+    pParams->reply.activeRmId = pDispEvo->headState[apiHead].activeRmId;
+    pParams->reply.colorFormat =
+        (NvU32)pDispEvo->headState[apiHead].procAmp.colorFormat;
+    pParams->reply.displayRate = pDispEvo->headState[apiHead].displayRate;
+
     return TRUE;
 }
 
