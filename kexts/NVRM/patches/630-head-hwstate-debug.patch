+static NvBool GetHeadHwState
+(
+    struct NvKmsKapiDevice *device,
+    NvU32 head,
+    struct NvKmsKapiHeadHwState *state
+)
+{
+    struct NvKmsQueryHeadHwStateParams params = { };
+    NvBool status;
+
+    if (device->hKmsDevice == 0x0) {
+        return NV_FALSE;
+    }
+
+    params.request.deviceHandle = device->hKmsDevice;
+    params.request.dispHandle   = device->hKmsDisp;
+    params.request.head         = head;
+
+    status = nvkms_ioctl_from_kapi(device->pKmsOpen,
+                                   NVKMS_IOCTL_QUERY_HEAD_HW_STATE,
+                                   &params, sizeof(params));
+
+    if (!status) {
+        nvKmsKapiLogDeviceDebug(device, "NVKMS QueryHeadHwState failed.");
+        return NV_FALSE;
+    }
+
+    state->headActive      = params.reply.headActive;
+    state->connectorDriven = params.reply.connectorDriven;
+    state->connectorActive = params.reply.connectorActive;
+    state->orType          = params.reply.orType;
+    state->orProtocol      = params.reply.orProtocol;
+    state->orMask          = params.reply.orMask;
+    state->orOwnerHeadMask = params.reply.orOwnerHeadMask;
+    state->hwHeadsMask     = params.reply.hwHeadsMask;
+    state->activeDpysMask  = params.reply.activeDpysMask;
+    state->activeRmId      = params.reply.activeRmId;
+    state->colorFormat     = params.reply.colorFormat;
+    state->displayRate     = params.reply.displayRate;
+
+    return NV_TRUE;
+}
