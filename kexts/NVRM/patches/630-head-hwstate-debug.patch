+struct NvKmsKapiHeadHwState {
+    NvBool headActive;      /*!< apiHeadState.activeDpys non-empty */
+    NvBool connectorDriven; /*!< headState.pConnectorEvo != NULL */
+    NvBool connectorActive; /*!< primary OR owned by a head */
+    NvU8 orType;            /*!< connector->or.type (0xff if none) */
+    NvU8 orProtocol;        /*!< connector->or.protocol */
+    NvU32 orMask;           /*!< connector OR mask */
+    NvU32 orOwnerHeadMask;  /*!< head mask owning the primary OR */
+    NvU32 hwHeadsMask;      /*!< hardware heads mapped to this api head */
+    NvU32 activeDpysMask;   /*!< activeDpys as an opaque mask */
+    NvU32 activeRmId;       /*!< nonzero only while a mode is driven */
+    NvU32 colorFormat;      /*!< color format the head drives */
+    NvU32 displayRate;      /*!< display rate the head drives */
+};
