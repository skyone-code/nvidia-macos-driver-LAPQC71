+static void GetEventCounters
+(
+    NvU32 *dpyChanged,
+    NvU32 *dynamicDpyConnected,
+    NvU32 *flipOccurred,
+    NvU32 *total
+)
+{
+    if (dpyChanged != NULL) {
+        *dpyChanged = sKapiEvtDpyChanged;
+    }
+    if (dynamicDpyConnected != NULL) {
+        *dynamicDpyConnected = sKapiEvtDynDpyConnected;
+    }
+    if (flipOccurred != NULL) {
+        *flipOccurred = sKapiEvtFlipOccurred;
+    }
+    if (total != NULL) {
+        *total = sKapiEvtTotal;
+    }
