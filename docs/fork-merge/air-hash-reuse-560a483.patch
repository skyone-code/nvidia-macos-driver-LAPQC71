+static NSString *nvmtl_air_text_from_bytes(const void *bytes, NSUInteger length) {
+    if (!bytes) return nil;
+    return nvmtl_air_text_made([[NSString alloc] initWithBytes:bytes length:length encoding:NSUTF8StringEncoding]);
